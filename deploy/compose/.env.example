# Environment of the Docker Compose stack (deploy/compose/docker-compose.yml).
# Copy to deploy/compose/.env — scripts/compose-init.sh does that and fills the passwords with random
# values. The file holds secrets: it is git-ignored and excluded from the Docker build context.
# Reference for every SPINNERET_* variable: documents/en/03-configuration.md

# --- Required (generated by scripts/compose-init.sh) -----------------------------------------------
# Passwords of the bundled databases. Changing them after the first start requires recreating the
# postgres / clickhouse volumes, or changing the password inside the database as well.
PG_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Console administrator created once by `--profile init run --rm init-admin`. Change the password after
# the first sign-in; this value is only read by that one-shot command.
SPINNERET_ADMIN_USERNAME=admin
SPINNERET_ADMIN_PASSWORD=change-me-please-12

# --- Stack layout ----------------------------------------------------------------------------------
# Host port of the Caddy load balancer that serves the console and the API.
SPINNERET_PORT=8080
# Number of spinneret server replicas behind the load balancer (stateless; scale freely).
SPINNERET_REPLICAS=2

# --- Server settings -------------------------------------------------------------------------------
# Log level of the server: debug | info | warn | error.
SPINNERET_LOG_LEVEL=info
# Mark session cookies Secure: auto (when the request arrived over TLS or with X-Forwarded-Proto: https),
# true (always) or false (plain-HTTP intranet only).
SPINNERET_COOKIE_SECURE=auto

# --- Optional --------------------------------------------------------------------------------------
# Number of Redis report stream shards (1..255, default 16). It bounds how many workers process reports
# in parallel. Fixed for the life of a deployment: lease IDs encode their shard, so changing it strands
# in-flight leases (documents/en/16-operations.md).
#SPINNERET_REPORT_SHARDS=16

# Concurrent acquire scripts the *whole fleet* may have in flight at Redis (0..65536, default 64).
# Each API instance admits this budget divided by the number of live API instances it sees, clamped to
# [4, 4096], and sheds the excess as unavailable/overloaded with a retry hint instead of queueing it at
# Redis. 0 turns admission control off and restores the unbounded behaviour (documents/en/17-performance.md).
#SPINNERET_ACQUIRE_FLEET_INFLIGHT=64

# Pin this instance's acquire limit instead of dividing the fleet budget (0..4096, default 0 = derive).
# Use it when Redis capacity scales with the number of primaries (set the per-primary figure), when you
# measured your own ceiling, or for reproducible load tests. A positive value also stops the instance
# heartbeat that counts live API instances — so pin it on *every* API instance or on none: instances
# that pin do not register as acquirers, the ones that derive then divide by too small a count, and the
# fleet total exceeds the budget by the pinned instances' whole allocation.
#SPINNERET_ACQUIRE_MAX_INFLIGHT=0

# Reminder for hand-written deployments (this stack does not pass the variable through, so the unique
# default always applies here): every API instance must have a *distinct* SPINNERET_INSTANCE_ID. The id
# is the registry member name the fleet budget is divided by, so N instances sharing one id collapse
# into a single member, each reports spinneret_acquire_peers = 1 and each admits the whole budget.
# Leave it unset — the default is the hostname plus a random suffix — or template it per replica.

# URL fetched *through* every proxy by the health checker (unset: the server's built-in check URL).
# On a host without internet access — or for demos whose proxies are the mock target
# (scripts/example-quickstart.sh, profiles test/example) — point it at the mock target so proxies stay
# "active" instead of being marked dead.
#SPINNERET_PROXY_CHECK_URL=http://mocktarget:9090/healthz

# PostgreSQL pool size per replica (default 32). Keep postgres max_connections above
# SPINNERET_REPLICAS * this value plus headroom.
#SPINNERET_DATABASE_MAX_CONNS=32

# --- Profile services ------------------------------------------------------------------------------
# observability: host port of Prometheus.
#PROMETHEUS_PORT=9090
# test / loadtest / example: host ports of the mock target site and its authenticating HTTP proxy.
#MOCK_TARGET_PORT=19090
#MOCK_PROXY_PORT=19091
# example: host port of the FastAPI example crawler. EXAMPLE_TOKEN is the node token, written here by
# scripts/example-quickstart.sh — the crawler refuses to start without it.
#EXAMPLE_PORT=18000
#EXAMPLE_TOKEN=
# loadtest: node token used by the k6 scenarios; `spnr seed` prints one (test/load/README.md).
#LOADTEST_TOKEN=

# Release feed the console's update check reads (Settings -> System). The check runs only when an
# operator presses the button, never on a timer, and the request carries nothing about this
# deployment. Set it to the empty string to disable the check and make the server reach nothing.
#SPINNERET_UPDATE_CHECK_URL=https://api.github.com/repos/TikHub/Spinneret/releases/latest
